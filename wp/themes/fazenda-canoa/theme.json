{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1180px",
      "wideSize": "1440px"
    },
    "color": {
      "palette": [
        { "slug": "paper",      "color": "#FFFFFF",           "name": "Paper" },
        { "slug": "paper-soft", "color": "#F0EEED",           "name": "Paper Soft (bege mestre)" },
        { "slug": "paper-mid",  "color": "#E8E5E3",           "name": "Paper Mid" },
        { "slug": "ink",        "color": "#1C1B13",           "name": "Ink (preto-marrom mestre)" },
        { "slug": "text-2",     "color": "#5B5B5B",           "name": "Text 2 (cinza médio mestre)" },
        { "slug": "text-mute",  "color": "#878787",           "name": "Text Muted (cinza claro mestre)" },
        { "slug": "line",       "color": "#E1DCD8",           "name": "Line" },
        { "slug": "accent",     "color": "#C02B0A",           "name": "Accent (corten/vermelho mestre)" },
        { "slug": "accent-2",   "color": "#878577",           "name": "Accent 2 (khaki bege mestre)" },
        { "slug": "warning",    "color": "#C02B0A",           "name": "Warning (corten — alinhado ao accent)" },
        { "slug": "warning-soft","color": "#FBE5DF",          "name": "Warning Soft" },
        { "slug": "whatsapp",   "color": "#25D366",           "name": "WhatsApp" }
      ],
      "gradients": [],
      "custom": true,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false
    },
    "typography": {
      "customFontSize": true,
      "dropCap": false,
      "fontFamilies": [
        {
          "fontFamily": "'Farnham Display', Georgia, serif",
          "slug": "farnham-display",
          "name": "Farnham Display",
          "fontFace": [
            { "fontFamily": "Farnham Display", "fontStyle": "normal",  "fontWeight": "300", "fontDisplay": "swap", "src": [ "file:./assets/fonts/farnham/FarnhamDisplay-Light.woff2" ] },
            { "fontFamily": "Farnham Display", "fontStyle": "italic",  "fontWeight": "300", "fontDisplay": "swap", "src": [ "file:./assets/fonts/farnham/FarnhamDisplay-LightItalic.woff2" ] },
            { "fontFamily": "Farnham Display", "fontStyle": "normal",  "fontWeight": "500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/farnham/FarnhamDisplay-Medium.woff2" ] }
          ]
        },
        {
          "fontFamily": "'Farnham Text', Georgia, serif",
          "slug": "farnham-text",
          "name": "Farnham Text",
          "fontFace": [
            { "fontFamily": "Farnham Text", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/fonts/farnham/FarnhamText-Regular.woff2" ] }
          ]
        },
        {
          "fontFamily": "'Sackers Gothic', 'Trajan Pro', Georgia, serif",
          "slug": "sackers",
          "name": "Sackers Gothic",
          "fontFace": [
            { "fontFamily": "Sackers Gothic", "fontStyle": "normal", "fontWeight": "300", "fontDisplay": "swap", "src": [ "file:./assets/fonts/sackers/SackersGothic-Light.woff2" ] },
            { "fontFamily": "Sackers Gothic", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": [ "file:./assets/fonts/sackers/SackersGothic-Medium.woff2" ] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "x-small", "size": "0.75rem", "name": "Extra Small" },
        { "slug": "small",   "size": "0.88rem", "name": "Small" },
        { "slug": "medium",  "size": "1rem",    "name": "Medium" },
        { "slug": "large",   "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "1.5rem",  "name": "Extra Large" },
        { "slug": "xx-large","size": "2rem",    "name": "XX Large" },
        { "slug": "display", "size": "2.8rem",  "name": "Display" }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 9,
        "mediumStep": 1.5,
        "unit": "rem"
      }
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--manrope)",
      "fontSize": "1rem",
      "lineHeight": "1.55",
      "fontWeight": "400"
    },
    "elements": {
      "h1": { "typography": { "fontWeight": "700", "letterSpacing": "-0.025em" } },
      "h2": { "typography": { "fontWeight": "600", "letterSpacing": "-0.02em" } },
      "h3": { "typography": { "fontWeight": "600", "letterSpacing": "-0.015em" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--ink)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--accent-2)" } }
      }
    }
  },
  "customTemplates": [
    {
      "name": "landing-page",
      "title": "Landing Page (Lago Fazenda Canoa)",
      "postTypes": [ "page" ]
    }
  ],
  "templateParts": [
    { "name": "header",           "title": "Header",           "area": "header" },
    { "name": "footer",           "title": "Footer",           "area": "footer" },
    { "name": "floating-widget",  "title": "Widget Flutuante", "area": "uncategorized" }
  ]
}
